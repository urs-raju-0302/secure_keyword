# Copy to .env and fill with securely generated values.
# Generate with: python scripts/gen_dev_secrets.py
# NEVER commit a real .env file.

# Database
POSTGRES_USER=securekw
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=secure_keyword
DATABASE_URL=postgresql+psycopg2://securekw:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/secure_keyword

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SCRIPTS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Master / KEK material (32+ bytes, base64 recommended)
MASTER_KEY=CHANGE_ME_GENERATE_WITH_SCRIPTS

# Object storage (MinIO / S3-compatible)
STORAGE_PROVIDER=s3
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=secure-documents
MINIO_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
MAX_UPLOAD_BYTES=10485760
ALLOWED_CONTENT_TYPES=text/plain,text/markdown,application/pdf,application/json

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
